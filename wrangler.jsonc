{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "yahtzee-score",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-19",
	"vars": { "DAILY_ROOM_LIMIT": "100" },
	"build": {
		"command": "npm run build"
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"migrations": [
		{
			"new_sqlite_classes": [
				"MyDurableObject"
			],
			"tag": "v1"
		},
		{ "tag": "v2", "new_sqlite_classes": ["RoomCreationQuota"] }
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "MyDurableObject",
				"name": "MY_DURABLE_OBJECT"
			},
			{ "class_name": "RoomCreationQuota", "name": "ROOM_CREATION_QUOTA" }
		]
	},
	// Account-wide namespace IDs: keep these distinct from other applications.
	"ratelimits": [
		{ "name": "API_RATE_LIMITER", "namespace_id": "26102601", "simple": { "limit": 300, "period": 60 } },
		{ "name": "CREATE_RATE_LIMITER", "namespace_id": "26102602", "simple": { "limit": 5, "period": 60 } },
		{ "name": "WRITE_RATE_LIMITER", "namespace_id": "26102603", "simple": { "limit": 120, "period": 60 } },
		{ "name": "LIVE_RATE_LIMITER", "namespace_id": "26102604", "simple": { "limit": 60, "period": 60 } }
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"redact_query_string": false,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": false,
			"head_sampling_rate": 1,
			"persist": true
		},
	},
	"upload_source_maps": true
}